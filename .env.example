# Copy to `.env.local` for local values. Vite only exposes vars prefixed with VITE_.

# Clerk publishable key (pk_test_... for development, pk_live_... for production). It's safe to ship
# in the client bundle; the secret key (sk_...) must never go in this app. Unset, the dashboard runs
# signed-out only and the sign-in card explains that Clerk isn't configured.
VITE_CLERK_PUBLISHABLE_KEY=

# Where the sibling apps live. Both open in a new window for now. Unset, they default to the local
# dev servers: NHL Stats pins 5173; Bulldog Shuttle takes 5174 when NHL Stats is already running.
VITE_NHL_STATS_URL=http://localhost:5173
VITE_BULLDOG_SHUTTLE_URL=http://localhost:5174

# Slug of the Clerk organization whose members can see the family-only Blog. Defaults to "family".
VITE_FAMILY_ORG_SLUG=family
